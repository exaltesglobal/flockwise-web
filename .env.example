# Where the Flockwise API lives. Same contract as the mobile app (docs/API.md + docs/API-ADMIN.md).
VITE_API_URL=https://api.flockwise.church/v1
# true = run against the built-in demo backend (no server needed). Set to false once the Hostinger API is live.
VITE_USE_MOCKS=true
# development | staging | production. Production hides the "Server" switcher.
VITE_APP_ENV=development
